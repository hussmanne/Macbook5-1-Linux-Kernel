#!/usr/bin/env bash
# Globally reapply PowerTOP after wake, but ONLY once its boot unit is enabled.
# Fresh Arch install delays the aggressive power policy until hardware qualified.
if [[ "${1:-}" == post && -x /usr/bin/powertop ]] &&
   /usr/bin/systemctl --quiet is-enabled mbp51-powertop.service; then
  /usr/bin/powertop --auto-tune || logger -t mbp51 "PowerTOP resume auto-tune failed"
fi
exit 0
